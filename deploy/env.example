# ============================================================
# 生产环境变量模板（systemd EnvironmentFile）
# 复制为 /etc/study-cockpit/env，权限 600，属主 cockpit
# 严禁把填好真实值的文件提交到仓库
# 生成随机密钥：openssl rand -base64 48
# ============================================================

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 数据库（MySQL 仅监听 127.0.0.1）
DB_URL=jdbc:mysql://127.0.0.1:3306/study_cockpit?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&connectionTimeZone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=false
DB_USERNAME=cockpit
DB_PASSWORD=

# JWT / 图片签名密钥：必须分别生成，长度 >= 32 字节，不得相同
JWT_SECRET=
FILE_TOKEN_SECRET=
JWT_TTL_MINUTES=30
FILE_TOKEN_TTL=1800
JWT_COOKIE_SECURE=true

# 图片存储（绝对路径，不在 Web 根目录）
FILE_STORAGE_DIR=/data/study-cockpit/uploads
FILE_MAX_SIZE=5MB
FILE_MAX_SIZE_BYTES=5242880

# 安全策略
APP_ALLOW_REGISTER=false
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15
